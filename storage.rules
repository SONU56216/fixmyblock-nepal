rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Photos can only be uploaded by authenticated users
    match /photos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }
  }
}